{
  "multipart": [
    {
      "apply": {
        "model": "marvelous_menagerie:block/williamsonia_center",
        "x": 90,
        "y": 90
      },
      "when": {
        "axis": "x"
      }
    },
    {
      "apply": {
        "model": "marvelous_menagerie:block/williamsonia_center"
      },
      "when": {
        "axis": "y"
      }
    },
    {
      "apply": {
        "model": "marvelous_menagerie:block/williamsonia_center",
        "x": 90
      },
      "when": {
        "axis": "z"
      }
    },



    {
      "apply": {
        "model": "marvelous_menagerie:block/williamsonia_top",
        "x": 90
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "marvelous_menagerie:block/williamsonia_top",
        "x": 90,
        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "marvelous_menagerie:block/williamsonia_bottom",
        "x": 90
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "marvelous_menagerie:block/williamsonia_bottom",
        "x": 90,
        "y": 90
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "marvelous_menagerie:block/williamsonia_top"
      },
      "when": {
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "marvelous_menagerie:block/williamsonia_bottom"
      },
      "when": {
        "down": "true"
      }
    }
  ]
}